---
/**
 * 01 Projekty (SPEC 8.1, 17.5) — interakcja 2 i 3.
 *
 * Jeden zestaw znaczników obsługuje wszystkie układy:
 *
 *  ruch włączony (każda szerokość) — sekcja przypięta (pin 1 z 2 na
 *    desktopie, JEDYNY pin na telefonie — 17.5). Trzy bloki leżą w tej samej
 *    komórce siatki: dema pokazują się po kolei, zrzut przewija się do końca
 *    wewnątrz ramki, potem crossfade do następnego, w obie strony.
 *    Desktop: tekst obok telefonu; telefon: skompresowany tekst nad
 *    telefonem. Obwódkę rysuje tylko pierwsza ramka.
 *
 *  `data-motion="off"` (wyłącznik awaryjny 17.5) i ograniczony ruch — trzy
 *    bloki jeden pod drugim bez pinu; przy samym `data-motion="off"` na
 *    telefonie zrzuty dalej przewija scrub (projektyMobileBezPinu).
 *
 * Układ nałożony włącza się tylko wtedy, gdy ruch jest dozwolony
 * (`html` bez `data-ruch="off"`) i sekcja nie ma `data-motion="off"` —
 * inaczej trzy bloki nachodziłyby na siebie bez niczego, co je rozdziela.
 */
import SectionHead from './SectionHead.astro';
import ProjectPanel from './ProjectPanel.astro';
import PhoneFrame from './PhoneFrame.astro';
import TintLayers from './TintLayers.astro';
import { projekty } from '../data/projekty';

interface Props {
  /** `off` wyłącza scrub i zostawia statyczne zrzuty (SPEC 8.1). */
  motion?: 'off';
}

const { motion } = Astro.props;
---

<TintLayers />

<section
  id="projekty"
  class:list={['projekty', motion === 'off' && 'projekty--bez-ruchu']}
  data-projekty
  data-motion={motion}
>
  <div class="kontener">
    <SectionHead
      index="01"
      linia1="Trzy segmenty rynku."
      linia2="Trzy projekty pokazowe."
      lead={'Trzy pełne strony dla fikcyjnych marek — po jednej na każdy typ gabinetu — żebyś zobaczyła produkt, zanim go zamówisz. Każdą otworzysz w przeglądarce jak prawdziwą.'}
    />
  </div>

  <div class="projekty__scena" data-scena>
    <div class="kontener projekty__bloki">
      {
        projekty.map((p, i) => (
          <div class="blok" data-blok={i} data-segment-klucz={p.segmentKlucz}>
            <div class="blok__tekst" data-tekst={i}>
              <ProjectPanel projekt={p} indeks={i} />
            </div>

            <div class="blok__telefon">
              <PhoneFrame>
                <img
                  class="zrzut"
                  data-zrzut={i}
                  src={p.zrzutMobile.src}
                  width={p.zrzutMobile.width / 2}
                  height={p.zrzutMobile.height / 2}
                  alt={p.altMobile}
                  decoding="async"
                  loading="lazy"
                  fetchpriority="low"
                />
              </PhoneFrame>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projekty {
    padding-block: var(--spacing-sekcja);
    scroll-margin-top: 5rem;
  }

  .projekty__scena {
    margin-top: 4rem;
  }

  .zrzut {
    width: 100%;
    height: auto;
    /* Zrzut jest wyższy od ekranu — nadmiar przycina ramka, a scrub
       przesuwa obraz w pionie (SPEC 8.1). */
    will-change: auto;
  }

  /* --- mobile i ograniczony ruch ---------------------------------------- */

  .blok + .blok {
    margin-top: clamp(4rem, 2rem + 8vw, 7rem);
  }

  .blok__telefon {
    /* 68% szerokości ekranu, nie kontenera (SPEC 8.1) — stąd `vw`.
       Przesunięty w prawo, poza oś tekstu (SPEC 6.2). */
    width: 68vw;
    max-width: 100%;
    margin-left: auto;
    margin-top: 2.5rem;
  }

  /* --- układ nałożony (ruch włączony) ------------------------------------ */
  /* Od 17.5 sekcja jest przypięta na KAŻDEJ szerokości, więc bloki leżą na
     sobie wspólnie dla desktopu i telefonu. Gdyby skrypt nie wstał,
     `data-ruch` przechodzi na `off` i wszystko wraca do układu pionowego;
     to samo robi `data-motion="off"` (klasa `projekty--bez-ruchu`) —
     wyłącznik awaryjny z 17.5. */

  :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .projekty__bloki {
    display: grid;
  }

  :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok {
    grid-area: 1 / 1;
    margin-top: 0;
  }

  /* Obwódkę i tło ekranu rysuje tylko pierwsza ramka — pozostałe dwie
     leżą dokładnie na niej i dokładałyby drugą krawędź. */
  :global(html:not([data-ruch='off']))
    .projekty:not(.projekty--bez-ruchu)
    .blok:not([data-blok='0'])
    .blok__telefon
    :global(.telefon) {
    border-color: transparent;
    background-color: transparent;
  }

  :global(html:not([data-ruch='off']))
    .projekty:not(.projekty--bez-ruchu)
    .blok:not([data-blok='0'])
    .blok__telefon
    :global(.telefon__ekran) {
    background-color: transparent;
  }

  /* Panele 2 i 3 startują niewidoczne; odsłania je scrub. */
  :global(html:not([data-ruch='off']))
    .projekty:not(.projekty--bez-ruchu)
    .blok:not([data-blok='0'])
    .blok__tekst {
    opacity: 0;
  }

  :global(html:not([data-ruch='off']))
    .projekty:not(.projekty--bez-ruchu)
    .blok:not([data-blok='0'])
    .zrzut {
    opacity: 0;
  }

  /* --- desktop: tekst obok telefonu -------------------------------------- */

  @media (min-width: 1024px) {
    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .projekty__bloki {
      /* Sekcja jest przypięta, więc scena wypełnia ekran. */
      min-height: 100vh;
      align-content: center;
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok {
      display: grid;
      grid-template-columns: 1fr 42%;
      gap: clamp(2rem, 4vw, 5rem);
      align-items: center;
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok__telefon {
      width: 100%;
      margin: 0;
      /* Telefon przesunięty względem osi tekstu (SPEC 6.2) */
      transform: translateY(clamp(1rem, 2vw, 2rem));
    }

    /* Sekcja jest przypięta, więc telefon musi się zmieścić w ekranie w całości
       — inaczej przy szerokiej kolumnie ucina mu się góra i dół. Wysokość
       prowadzi, szerokość dolicza `aspect-ratio` z PhoneFrame. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__telefon
      :global(.telefon) {
      /* Celowo bez `min(72vh, 100%)`: rodzic ma wysokość `auto`, więc procent
         jest nieokreślony i przeglądarka wyrzuca całą deklarację. */
      height: 72vh;
      width: auto;
      max-width: 100%;
      /* Dosunięty do prawej krawędzi kolumny */
      margin-left: auto;
    }
  }

  /* --- telefon z pinem (17.5): tekst nad telefonem ------------------------ */

  @media (max-width: 1023px) {
    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      /* Kadr = ekran. `svh` nie zmienia się przy chowaniu paska adresu,
         więc geometria zmierzona raz zostaje aktualna (SPEC 10.2). */
      height: 100vh;
      height: 100svh;
      /* Góra: belka nawigacji; dół: pasek CTA, który wjeżdża w trakcie. */
      padding-block: 5rem calc(4.5rem + env(safe-area-inset-bottom));
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok__tekst {
      flex: none;
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok__telefon {
      flex: 1 1 auto;
      min-height: 0;
      width: auto;
      margin: 0;
      display: flex;
      /* Telefon poza osią tekstu, przy prawej krawędzi (SPEC 6.2) */
      justify-content: flex-end;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__telefon
      :global(.telefon) {
      height: 100%;
      /* Bezpiecznik proporcji na bardzo niskich ekranach */
      max-height: calc(74vw * 844 / 390);
      width: auto;
    }

    /* Panel tekstowy skompresowany, żeby razem z telefonem zmieścił się
       w przypiętym kadrze. Etykieta „Projekt pokazowy (marka fikcyjna)"
       zostaje zawsze (SPEC 15); Łącznik, liczby i data pomiaru wracają
       w wariancie bez pinu i na podstronie projektu. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__nazwa) {
      margin-top: 0.5rem;
      font-size: var(--text-h3);
      line-height: 1.2;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__lacznik),
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__liczby),
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__pomiar) {
      display: none;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__problem) {
      margin-top: 0.75rem;
      font-size: var(--text-body);
      line-height: 1.45;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__rozwiazanie) {
      margin-top: 0.5rem;
      font-size: var(--text-small);
      line-height: 1.45;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__tekst
      :global(.panel__linki) {
      margin-top: 0.75rem;
      gap: 0.25rem 1.5rem;
    }
  }
</style>

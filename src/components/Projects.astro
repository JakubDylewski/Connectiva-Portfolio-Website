---
/**
 * 01 Projekty (SPEC 8.1, 17.12) — interakcja 2 i 3.
 *
 * Jeden zestaw znaczników obsługuje wszystkie układy:
 *
 *  desktop z ruchem (≥ 1024 px, SPEC 8.1) — sekcja przypięta (pin 1 z 2).
 *    Trzy bloki leżą w tej samej komórce siatki: tekst obok telefonu, dema
 *    pokazują się po kolei, zrzut przewija się do końca wewnątrz ramki,
 *    potem crossfade do następnego, w obie strony. Obwódkę rysuje tylko
 *    pierwsza ramka.
 *
 *  telefon z ruchem (< 1024 px, SPEC 17.12) — bloki w normalnym przepływie,
 *    na przemian: pełny blok info (NIE pinowany), potem okno dema — ramka
 *    o stałej wysokości 75dvh z etykietą nazwy, pinowana tylko na czas
 *    przewijania zrzutu. Trzy piny sekwencyjne, nigdy aktywne jednocześnie
 *    (motion.ts, projektyMobilePiny).
 *
 *  `data-motion="off"` (wyłącznik awaryjny 17.5/17.12) i ograniczony ruch —
 *    trzy bloki jeden pod drugim bez pinów; przy samym `data-motion="off"`
 *    na telefonie zrzuty dalej przewija scrub (projektyMobileBezPinu).
 *
 * Układ nałożony (desktop) włącza się tylko wtedy, gdy ruch jest dozwolony
 * (`html` bez `data-ruch="off"`) i sekcja nie ma `data-motion="off"` —
 * inaczej trzy bloki nachodziłyby na siebie bez niczego, co je rozdziela.
 */
import SectionHead from './SectionHead.astro';
import ProjectPanel from './ProjectPanel.astro';
import PhoneFrame from './PhoneFrame.astro';
import TintLayers from './TintLayers.astro';
import { projekty } from '../data/projekty';

interface Props {
  /** `off` wyłącza scrub i zostawia statyczne zrzuty (SPEC 8.1). */
  motion?: 'off';
}

const { motion } = Astro.props;
---

<TintLayers />

<section
  id="projekty"
  class:list={['projekty', motion === 'off' && 'projekty--bez-ruchu']}
  data-projekty
  data-motion={motion}
>
  <div class="kontener">
    <SectionHead
      index="01"
      linia1="Trzy segmenty rynku."
      linia2="Trzy projekty pokazowe."
      lead={'Trzy pełne strony dla fikcyjnych marek — po jednej na każdy typ gabinetu — żebyś zobaczyła produkt, zanim go zamówisz. Każdą otworzysz w przeglądarce jak prawdziwą.'}
    />
  </div>

  <div class="projekty__scena" data-scena>
    <div class="kontener projekty__bloki">
      {
        projekty.map((p, i) => (
          <div class="blok" data-blok={i} data-segment-klucz={p.segmentKlucz}>
            <div class="blok__tekst" data-tekst={i}>
              <ProjectPanel projekt={p} indeks={i} />
            </div>

            <div class="blok__telefon" data-okno={i}>
              {/* Etykieta widoczna tylko w pinowanym wariancie mobile —
                  blok info przewinął się wyżej, więc nazwa nad ramką mówi,
                  które demo jest w oknie (SPEC 17.12). */}
              <p class="blok__okno-etykieta">{p.nazwa}</p>
              <PhoneFrame>
                <img
                  class="zrzut"
                  data-zrzut={i}
                  src={p.zrzutMobile.src}
                  width={p.zrzutMobile.width / 2}
                  height={p.zrzutMobile.height / 2}
                  alt={p.altMobile}
                  decoding="async"
                  loading="lazy"
                  fetchpriority="low"
                />
              </PhoneFrame>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projekty {
    padding-block: var(--spacing-sekcja);
    scroll-margin-top: 5rem;
  }

  .projekty__scena {
    margin-top: 4rem;
  }

  .zrzut {
    width: 100%;
    height: auto;
    /* Zrzut jest wyższy od ekranu — nadmiar przycina ramka, a scrub
       przesuwa obraz w pionie (SPEC 8.1). */
    will-change: auto;
  }

  /* --- układ podstawowy: bloki jeden pod drugim -------------------------- */
  /* Obowiązuje przy `data-motion="off"`, ograniczonym ruchu i gdy skrypt
     nie wstał (`data-ruch="off"`). */

  .blok + .blok {
    margin-top: clamp(4rem, 2rem + 8vw, 7rem);
  }

  .blok__telefon {
    /* 68% szerokości ekranu, nie kontenera (SPEC 8.1) — stąd `vw`.
       Przesunięty w prawo, poza oś tekstu (SPEC 6.2). */
    width: 68vw;
    max-width: 100%;
    margin-left: auto;
    margin-top: 2.5rem;
  }

  .blok__okno-etykieta {
    /* Istnieje tylko w pinowanym wariancie mobile (17.12) — w pozostałych
       układach nazwa stoi tuż obok w bloku info, więc etykieta by dublowała. */
    display: none;
    font-size: var(--text-small);
    color: var(--color-text-2);
  }

  /* --- desktop z ruchem: układ nałożony, tekst obok telefonu ------------- */
  /* Od 17.12 bloki leżą na sobie TYLKO na desktopie — telefon ma własną
     sekwencję blok info → przypięte okno w normalnym przepływie. */

  @media (min-width: 1024px) {
    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .projekty__bloki {
      display: grid;
      /* Sekcja jest przypięta, więc scena wypełnia ekran. */
      min-height: 100vh;
      align-content: center;
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok {
      grid-area: 1 / 1;
      margin-top: 0;
      display: grid;
      grid-template-columns: 1fr 42%;
      gap: clamp(2rem, 4vw, 5rem);
      align-items: center;
    }

    /* Obwódkę i tło ekranu rysuje tylko pierwsza ramka — pozostałe dwie
       leżą dokładnie na niej i dokładałyby drugą krawędź. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok:not([data-blok='0'])
      .blok__telefon
      :global(.telefon) {
      border-color: transparent;
      background-color: transparent;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok:not([data-blok='0'])
      .blok__telefon
      :global(.telefon__ekran) {
      background-color: transparent;
    }

    /* Panele 2 i 3 startują niewidoczne; odsłania je scrub. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok:not([data-blok='0'])
      .blok__tekst {
      opacity: 0;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok:not([data-blok='0'])
      .zrzut {
      opacity: 0;
    }

    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok__telefon {
      width: 100%;
      margin: 0;
      /* Telefon przesunięty względem osi tekstu (SPEC 6.2) */
      transform: translateY(clamp(1rem, 2vw, 2rem));
    }

    /* Sekcja jest przypięta, więc telefon musi się zmieścić w ekranie w całości
       — inaczej przy szerokiej kolumnie ucina mu się góra i dół. Wysokość
       prowadzi, szerokość dolicza `aspect-ratio` z PhoneFrame. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__telefon
      :global(.telefon) {
      /* Celowo bez `min(72vh, 100%)`: rodzic ma wysokość `auto`, więc procent
         jest nieokreślony i przeglądarka wyrzuca całą deklarację. */
      height: 72vh;
      width: auto;
      max-width: 100%;
      /* Dosunięty do prawej krawędzi kolumny */
      margin-left: auto;
    }
  }

  /* --- telefon z ruchem (17.12): blok info, potem przypięte okno --------- */
  /* Blok info to pełny ProjectPanel w normalnym przepływie — bez kompresji.
     Okno pinuje motion.ts (projektyMobilePiny), tu tylko wymiary i układ. */

  @media (max-width: 1023px) {
    :global(html:not([data-ruch='off'])) .projekty:not(.projekty--bez-ruchu) .blok__telefon {
      width: 100%;
      margin: 3rem 0 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__okno-etykieta {
      display: block;
    }

    /* Stały, identyczny rozmiar wszystkich trzech okien (17.12): wysokość
       75dvh (fallback 75vh), szerokość z proporcji 390:844 przez
       `aspect-ratio` PhoneFrame, bezpiecznik `max-width: 92vw`. Fallback
       przez `@supports`, bo minifikator usuwa zdublowane `height`. */
    :global(html:not([data-ruch='off']))
      .projekty:not(.projekty--bez-ruchu)
      .blok__telefon
      :global(.telefon) {
      height: 75vh;
      width: auto;
      max-width: 92vw;
    }

    @supports (height: 1dvh) {
      :global(html:not([data-ruch='off']))
        .projekty:not(.projekty--bez-ruchu)
        .blok__telefon
        :global(.telefon) {
        height: 75dvh;
      }
    }
  }
</style>

---
/**
 * 06 Cena (SPEC 8.6) — interakcja 8.
 *
 * Konfigurator: duża liczba, cztery przełączniki, płatność, opieka i lista
 * tego, czego w cenie nie ma. Ten sam komponent stoi w sekcji 06 na stronie
 * głównej i na `/cennik/`.
 *
 * UCZCIWOŚĆ (SPEC 15): nigdzie nie pada „od”. Widełki są jawne, a to, czego
 * w cenie nie ma, jest wypisane wprost, a nie schowane w gwiazdce.
 *
 * Kwoty przełączników to placeholdery ze SPEC 8.6 — do potwierdzenia przez
 * Jakuba (decyzja otwarta nr 5).
 */
import cennik from '../data/cennik.json';
import { site } from '../site.config';

const suma = cennik.przelaczniki.reduce((a, p) => a + p.kwota, 0);

// Zabezpieczenie budowania: widełki muszą się domykać. Gdyby ktoś zmienił
// kwotę w cennik.json i rozjechał sumę, build ma paść tutaj, a nie cicho
// wypuścić stronę z ceną poza widełkami (SPEC 8.6).
if (cennik.baza + suma !== cennik.gorna) {
  throw new Error(
    `cennik.json: baza ${cennik.baza} + przełączniki ${suma} = ${
      cennik.baza + suma
    }, a górna granica to ${cennik.gorna}. Widełki muszą się domykać.`,
  );
}

const NBSP = ' ';
const zl = (n: number) => n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, NBSP);

const id = `cennik-${crypto.randomUUID().slice(0, 8)}`;

// Netto czy brutto zależy od tego, czy JDG jest podatnikiem VAT —
// decyzja otwarta nr 2 (SPEC 16). Dopóki nie zapadnie, nie zgadujemy.
const vat = site.cenyVat;
---

<div
  class="cennik"
  data-cennik
  data-baza={cennik.baza}
  data-gorna={cennik.gorna}
>
  <div class="cennik__kwota">
    <p class="cennik__liczba">
      <span data-kwota>{zl(cennik.baza)}</span>{NBSP}{cennik.waluta}
    </p>
    <p class="cennik__widelki">
      Zawsze w&nbsp;widełkach {zl(cennik.baza)}–{zl(cennik.gorna)}{NBSP}{cennik.waluta}.{' '}
      {
        vat ? (
          <span>Ceny {vat}.</span>
        ) : (
          <span class="cennik__todo">
            (netto czy brutto — do ustalenia przed publikacją)
          </span>
        )
      }
    </p>
  </div>

  <div class="cennik__kolumny">
    <div class="cennik__blok">
      <h3 class="cennik__tytul">W cenie bazowej</h3>
      <ul class="cennik__lista">
        {cennik.zawiera.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="cennik__blok">
      <h3 class="cennik__tytul">Co podnosi cenę</h3>
      <ul class="cennik__opcje">
        {
          cennik.przelaczniki.map((p) => (
            <li class="opcja">
              <input
                class="opcja__input"
                type="checkbox"
                id={`${id}-${p.id}`}
                data-kwota-opcji={p.kwota}
              />
              <label class="opcja__etykieta" for={`${id}-${p.id}`}>
                <span class="opcja__nazwa">{p.etykieta}</span>
                <span class="opcja__kwota">
                  +{zl(p.kwota)}
                  {NBSP}
                  {cennik.waluta}
                </span>
              </label>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="cennik__doly">
    <div class="cennik__blok">
      <h3 class="cennik__tytul">Płatność</h3>
      <p class="cennik__tekst">{cennik.platnosc}</p>
    </div>

    <div class="cennik__blok">
      <h3 class="cennik__tytul">Opieka, osobno i&nbsp;opcjonalnie</h3>
      <p class="cennik__tekst">
        <strong class="cennik__opieka">
          {zl(cennik.opieka.kwota)}{NBSP}{cennik.waluta} miesięcznie:
        </strong>{' '}
        {cennik.opieka.opis}
      </p>
    </div>

    <div class="cennik__blok">
      <h3 class="cennik__tytul">Nie ma w&nbsp;cenie</h3>
      <ul class="cennik__lista cennik__lista--brak">
        {cennik.nieMaWCenie.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</div>

<style>
  .cennik {
    margin-top: 3rem;
  }

  /* --- kwota ------------------------------------------------------------- */

  .cennik__liczba {
    font-family: var(--font-display);
    font-size: var(--text-price);
    font-weight: 300;
    line-height: 1;
    /* Cyfry o stałej szerokości — liczba nie „skacze" przy zmianie (SPEC 5) */
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .cennik__widelki {
    margin-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-text-3);
  }

  .cennik__todo {
    color: var(--color-text-3);
  }

  /* --- kolumny ----------------------------------------------------------- */

  .cennik__kolumny,
  .cennik__doly {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
  }

  .cennik__tytul {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-2);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cennik__lista {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-text-2);
  }

  .cennik__lista li {
    display: flex;
    gap: 0.75rem;
  }

  .cennik__lista li::before {
    content: '';
    flex: none;
    width: 12px;
    height: 1px;
    margin-top: 0.8em;
    background-color: var(--color-line-2);
  }

  .cennik__lista--brak li {
    color: var(--color-text-3);
  }

  .cennik__tekst {
    margin-top: 1.25rem;
    color: var(--color-text-2);
  }

  .cennik__opieka {
    color: var(--color-text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* --- przełączniki ------------------------------------------------------ */

  .cennik__opcje {
    margin-top: 0.5rem;
  }

  .opcja {
    position: relative;
    border-bottom: 1px solid var(--color-line);
  }

  .opcja__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .opcja__etykieta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    /* Cel dotyku ≥ 44 px (SPEC 7.4) */
    min-height: 56px;
    padding-block: 1rem;
    cursor: pointer;
    color: var(--color-text-2);
    transition: color 200ms var(--ease-wejscie);
  }

  .opcja__nazwa {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* Znacznik wyboru: kwadrat, który wypełnia się po zaznaczeniu. Stan niosą
     kształt, kolor i `:checked` na inpucie — nie sam kolor (SPEC 11.3). */
  .opcja__nazwa::before {
    content: '';
    flex: none;
    width: 18px;
    height: 18px;
    border: 1px solid var(--color-line-2);
    border-radius: 3px;
    transform: translateY(0.15em);
    transition:
      background-color 200ms var(--ease-wejscie),
      border-color 200ms var(--ease-wejscie);
  }

  .opcja__input:checked + .opcja__etykieta {
    color: var(--color-text);
  }

  .opcja__input:checked + .opcja__etykieta .opcja__nazwa::before {
    background-color: var(--color-green);
    border-color: var(--color-green);
  }

  .opcja__input:hover + .opcja__etykieta {
    color: var(--color-text);
  }

  .opcja__input:focus-visible + .opcja__etykieta {
    outline: 2px solid var(--color-lime);
    outline-offset: 3px;
  }

  .opcja__kwota {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-3);
  }

  .opcja__input:checked + .opcja__etykieta .opcja__kwota {
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .cennik__kolumny {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .cennik__doly {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opcja__etykieta,
    .opcja__nazwa::before {
      transition: none;
    }
  }
</style>

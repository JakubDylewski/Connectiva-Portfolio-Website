---
/**
 * Przycisk (SPEC 7.4).
 *
 * Trzy warianty: główny, wtórny, tekstowy. Bez gradientu na tle — gradient
 * pojawia się wyłącznie jako Łącznik pod przyciskiem głównym na hover.
 * Zaokrąglenie 6 px, nigdy pill.
 *
 * Magnetyzm kursora (SPEC 7.4, tylko desktop) dokładamy w Etapie 8.
 */
import Lacznik from './Lacznik.astro';

interface Props {
  wariant?: 'glowny' | 'wtorny' | 'tekstowy';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Link zewnętrzny — dokłada target/rel i informację dla czytników. */
  zewnetrzny?: boolean;
  /** Przesunięcie o 8 px w dół na desktopie (zasada przesunięcia, SPEC 6.2). */
  przesuniety?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  wariant = 'glowny',
  href,
  type = 'button',
  zewnetrzny = false,
  przesuniety = false,
  class: klasa,
  ...reszta
} = Astro.props;

// Celowo dwie osobne gałęzie zamiast dynamicznego `<Tag>`: Astro nie dokłada
// atrybutu zakresu (`data-astro-cid-…`) do elementu o nazwie z wyrażenia,
// przez co całe `<style>` tego komponentu przestaje na niego działać.
const klasy = [
  'btn',
  `btn--${wariant}`,
  przesuniety && 'btn--przesuniety',
  wariant === 'glowny' && 'grupa-cta',
  klasa,
];

const linkExtra = zewnetrzny ? { target: '_blank', rel: 'noopener' } : {};
---

{
  href ? (
    <a class:list={klasy} href={href} {...linkExtra} {...reszta}>
      <span class="btn__tresc">
        <slot />
      </span>
      {zewnetrzny && (
        <span class="btn__czytnik"> (otwiera się w nowej karcie)</span>
      )}
      {
        wariant === 'glowny' && (
          <span class="btn__lacznik">
            <Lacznik wariant="cta" />
          </span>
        )
      }
    </a>
  ) : (
    <button class:list={klasy} type={type} {...reszta}>
      <span class="btn__tresc">
        <slot />
      </span>
      {
        wariant === 'glowny' && (
          <span class="btn__lacznik">
            <Lacznik wariant="cta" />
          </span>
        )
      }
    </button>
  )
}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Cel dotyku ≥ 44 × 44 px (SPEC 7.4) */
    min-height: 48px;
    min-width: 44px;
    padding-inline: 20px;
    border: 0;
    border-radius: var(--radius-kontrolka);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: transparent;
    transition:
      background-color 150ms var(--ease-wejscie),
      border-color 150ms var(--ease-wejscie),
      color 150ms var(--ease-wejscie),
      transform 150ms var(--ease-wejscie);
  }

  .btn:active {
    transform: scale(0.98);
  }

  /* --- główny ------------------------------------------------------------ */
  .btn--glowny {
    background-color: var(--color-text);
    color: var(--color-black);
  }
  .btn--glowny:hover {
    background-color: #ffffff;
  }

  /* --- wtórny ------------------------------------------------------------ */
  .btn--wtorny {
    border: 1px solid var(--color-line-2);
    color: var(--color-text);
  }
  .btn--wtorny:hover {
    border-color: var(--color-green);
  }

  /* --- tekstowy ---------------------------------------------------------- */
  .btn--tekstowy {
    min-height: 44px;
    padding-inline: 0;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-line-2);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
  .btn--tekstowy:hover {
    text-decoration-color: var(--color-green);
  }

  /* Przesunięcie pary przycisków na desktopie (SPEC 6.2) */
  @media (min-width: 1024px) {
    .btn--przesuniety {
      transform: translateY(8px);
    }
    .btn--przesuniety:active {
      transform: translateY(8px) scale(0.98);
    }
  }

  /* Łącznik jako podkreślenie przycisku głównego (SPEC 6.1, wariant cta) */
  .btn__lacznik {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    pointer-events: none;
  }

  /* Tekst tylko dla czytników ekranu */
  .btn__czytnik {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

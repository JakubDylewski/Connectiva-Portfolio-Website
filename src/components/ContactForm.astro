---
/**
 * Formularz kontaktowy (SPEC 8.8, wysyłka: SPEC 17.16).
 *
 * Zgłoszenia odbiera Margo — endpoint i klucz Turnstile stoją
 * w `site.config.ts`, a całą wysyłkę (walidacja, token, komunikaty po polsku
 * dla każdej odpowiedzi serwera) prowadzi wspólne `src/scripts/forms.ts`.
 *
 * Pola i limity długości odpowiadają kontraktowi `/lead`: imie (80),
 * salon (120, opcjonalne), kontakt (160 — telefon, e-mail albo Instagram),
 * wiadomosc (2000). Pułapka `www` ma zostać pusta — wypełnia ją tylko bot.
 */
import Button from './Button.astro';
import { site } from '../site.config';

const id = `kontakt-${crypto.randomUUID().slice(0, 8)}`;

const politykaIstnieje =
  Object.keys(import.meta.glob('../pages/polityka-prywatnosci.astro')).length > 0;
---

<form
  class="kform"
  data-formularz
  data-margo={site.margo.endpoint}
  data-sitekey={site.margo.turnstileSiteKey}
  data-mail-zapas={site.email}
  data-tekst-ok={'Dzięki! Odezwę się najpóźniej w ciągu 24 h.'}
  data-chowa-pasek
  novalidate
>
  {/* Honeypot — widoczny tylko dla botów (SPEC 7.5). Nazwa `www` jest częścią
      kontraktu Margo: serwer odrzuca zgłoszenia z wypełnionym polem. */}
  <div class="kform__pulapka" aria-hidden="true">
    <label for={`${id}-www`}>Nie wypełniaj tego pola</label>
    <input
      id={`${id}-www`}
      type="text"
      name="www"
      tabindex="-1"
      autocomplete="off"
      data-honeypot
    />
  </div>

  <div class="kform__pola" data-pola>
    <div class="pole">
      <label class="pole__etykieta" for={`${id}-imie`}>Imię</label>
      <input
        class="pole__input"
        id={`${id}-imie`}
        name="imie"
        type="text"
        autocomplete="given-name"
        maxlength="80"
        required
        data-waliduj="wymagane"
        aria-describedby={`${id}-imie-blad`}
      />
      <p class="pole__blad" id={`${id}-imie-blad`} aria-live="polite"></p>
    </div>

    <div class="pole">
      <label class="pole__etykieta" for={`${id}-salon`}>
        Nazwa salonu lub kliniki <span class="pole__opcjonalne">(opcjonalnie)</span>
      </label>
      <input
        class="pole__input"
        id={`${id}-salon`}
        name="salon"
        type="text"
        autocomplete="organization"
        maxlength="120"
      />
    </div>

    <div class="pole">
      <label class="pole__etykieta" for={`${id}-kontakt`}>
        Telefon, e-mail lub Instagram
      </label>
      <input
        class="pole__input"
        id={`${id}-kontakt`}
        name="kontakt"
        type="text"
        maxlength="160"
        required
        data-waliduj="kontakt-tel"
        aria-describedby={`${id}-kontakt-blad`}
      />
      <p class="pole__blad" id={`${id}-kontakt-blad`} aria-live="polite"></p>
    </div>

    <div class="pole">
      <label class="pole__etykieta" for={`${id}-wiadomosc`}>Wiadomość</label>
      <textarea
        class="pole__input pole__input--obszar"
        id={`${id}-wiadomosc`}
        name="wiadomosc"
        rows="4"
        maxlength="2000"
        required
        data-waliduj="wymagane"
        aria-describedby={`${id}-wiadomosc-blad`}></textarea>
      <p class="pole__blad" id={`${id}-wiadomosc-blad`} aria-live="polite"></p>
    </div>

    <div class="pole">
      <div class="zgoda">
        <input
          class="zgoda__input"
          id={`${id}-zgoda`}
          name="zgoda"
          type="checkbox"
          required
          data-waliduj="zgoda"
          aria-describedby={`${id}-zgoda-blad`}
        />
        <label class="zgoda__etykieta" for={`${id}-zgoda`}>
          Zgadzam się na kontakt i&nbsp;na przetwarzanie moich danych.{' '}
          {
            politykaIstnieje ? (
              <a class="link" href="/polityka-prywatnosci/">
                Polityka prywatności
              </a>
            ) : (
              <span class="zgoda__todo">(polityka prywatności dochodzi wkrótce)</span>
            )
          }
        </label>
      </div>
      <p class="pole__blad" id={`${id}-zgoda-blad`} aria-live="polite"></p>
    </div>

    {/* Widżet Cloudflare Turnstile — renderuje go forms.ts po załadowaniu
        API. Zarezerwowana wysokość trzyma układ, zanim widżet wstanie. */}
    <div class="pole">
      <div class="kform__turnstile" data-turnstile></div>
    </div>

    <div class="kform__wyslij">
      <Button type="submit">Wyślij</Button>
    </div>
  </div>

  <p class="kform__stan" data-stan aria-live="polite"></p>
</form>

<style>
  .kform__pola {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pole__etykieta {
    display: block;
    font-size: var(--text-small);
    color: var(--color-text-2);
    margin-bottom: 0.5rem;
  }

  .pole__opcjonalne {
    color: var(--color-text-3);
  }

  .pole__input {
    width: 100%;
    max-width: 26rem;
    height: 48px;
    padding-inline: 0.875rem;
    background-color: var(--color-ink-1);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-kontrolka);
    color: var(--color-text);
    transition: border-color 150ms var(--ease-wejscie);
  }

  .pole__input--obszar {
    height: auto;
    padding-block: 0.75rem;
    resize: vertical;
    line-height: 1.5;
  }

  .pole__input:hover {
    border-color: var(--color-line-2);
  }

  .pole__input:focus {
    border-color: var(--color-green);
    background-color: var(--color-ink-2);
  }

  .pole__input[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .pole__blad {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-error);
  }

  .pole__blad:empty {
    margin-top: 0;
  }

  .zgoda {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .zgoda__input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--color-green);
  }

  .zgoda__etykieta {
    font-size: var(--text-small);
    color: var(--color-text-2);
    max-width: 34rem;
  }

  .zgoda__todo {
    color: var(--color-text-3);
  }

  /* Widżet w trybie flexible wypełnia kontener (minimum Cloudflare: 300 px),
     więc trzyma się tej samej szerokości co pola formularza. 65 px wysokości
     zarezerwowane z góry — układ nie skacze, gdy widżet się dorenderuje. */
  .kform__turnstile {
    width: 100%;
    max-width: 26rem;
    min-height: 65px;
  }

  .kform__wyslij {
    margin-top: 0.5rem;
    padding-bottom: 0.75rem;
  }

  .kform__stan {
    margin-top: 1.5rem;
    color: var(--color-text-2);
    max-width: 34rem;
  }

  .kform__stan:empty {
    margin-top: 0;
  }

  .kform[data-stan-wysylki='ok'] .kform__stan {
    color: var(--color-text);
  }

  .kform[data-stan-wysylki='blad'] .kform__stan {
    color: var(--color-error);
  }

  .kform__pulapka {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

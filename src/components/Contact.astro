---
/**
 * Sekcja Kontakt (SPEC 8.8).
 *
 * Lewa kolumna: termin startu, czas odpowiedzi, e-mail, Instagram.
 * Prawa: formularz.
 *
 * UCZCIWOŚĆ (SPEC 15, interakcja 10): „najbliższy wolny termin startu" to
 * zwykła data z `site.config.ts`, aktualizowana ręcznie. Bez licznika, bez
 * animacji, bez sugerowania, że miejsca właśnie się kończą.
 *
 * Komponent nie renderuje nagłówka — daje go `SectionHead` (h2 na stronie
 * głównej, h1 na `/kontakt/`), żeby nigdzie nie było dwóch h1 (SPEC 11.3).
 */
import ContactForm from './ContactForm.astro';
import { site } from '../site.config';

const uzupelnione = (v: string) => Boolean(v) && !v.startsWith('TODO_');
const mailOk = uzupelnione(site.email);
const instaOk = uzupelnione(site.instagram.nazwa) && uzupelnione(site.instagram.url);
---

<div class="kontakt">
  <div class="kontakt__info">
    <p class="kontakt__termin">
      Najbliższy wolny termin startu:{' '}
      <strong>{site.najblizszyTermin}</strong>
    </p>

    <p class="kontakt__odpowiedz">Odpowiedź w&nbsp;ciągu 24 godzin w&nbsp;dni robocze.</p>

    {
      (mailOk || instaOk) && (
        <ul class="kontakt__kanaly">
          {mailOk && (
            <li>
              <a class="link" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </li>
          )}
          {instaOk && (
            <li>
              <a class="link" href={site.instagram.url} target="_blank" rel="noopener">
                {site.instagram.nazwa}
                <span class="kontakt__czytnik"> (otwiera się w nowej karcie)</span>
              </a>
            </li>
          )}
        </ul>
      )
    }

    {
      !mailOk && !instaOk && (
        <p class="kontakt__todo">
          E-mail i&nbsp;Instagram dochodzą przed publikacją — uzupełnij je
          w&nbsp;src/site.config.ts.
        </p>
      )
    }
  </div>

  <div class="kontakt__formularz">
    <ContactForm />
  </div>
</div>

<style>
  .kontakt {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  .kontakt__termin {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-text-2);
  }

  .kontakt__termin strong {
    /* Zawsze we własnej linii. Bez tego zdanie balansowało na granicy
       łamania: fallback mieścił je w jednej linii, docelowy Hanken w dwóch,
       i podmiana fontu przesuwała cały formularz (CLS 0,109 — audyt
       Etapu 9). Stały układ etykieta / wartość ucina problem niezależnie
       od tego, jaki termin siedzi w site.config.ts. */
    display: block;
    color: var(--color-text);
    font-weight: 500;
  }

  .kontakt__odpowiedz {
    margin-top: 1rem;
    color: var(--color-text-2);
  }

  .kontakt__kanaly {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .kontakt__todo {
    margin-top: 2rem;
    font-size: var(--text-small);
    color: var(--color-text-3);
  }

  .kontakt__czytnik {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .kontakt {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }
</style>

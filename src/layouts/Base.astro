---
/**
 * Układ bazowy (SPEC 12).
 *
 * Etap 1: meta, skip link, `lang="pl"`, Nav, opcjonalny pasek dolny, Footer,
 * wpięcie warstwy ruchu i obsługi menu.
 * Etap 6 dokłada OG, JSON-LD i sitemapę. Etap 8 — View Transitions.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import MobileBar from '../components/MobileBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  tytul?: string;
  opis?: string;
  /** Strony robocze (np. `/styleguide/`) nie trafiają do wyszukiwarek. */
  noindex?: boolean;
  /** Podmiana linków w belce — używane tylko przez `/styleguide/`. */
  navLinki?: ReadonlyArray<{ etykieta: string; href: string }>;
  navCta?: { etykieta: string; href: string } | null;
  /** Dolny pasek na mobile (SPEC 7.3) — tylko tam, gdzie są cele CTA. */
  pasekMobile?: boolean;
  /** Strona ma sekwencję otwarcia hero (SPEC 8.0). */
  sekwencjaOtwarcia?: boolean;
}

const {
  tytul = site.tytul,
  opis = site.opis,
  noindex = false,
  navLinki,
  navCta,
  pasekMobile = false,
  sekwencjaOtwarcia = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Fonty są same-origin i wskazane z arkusza, który i tak blokuje
        renderowanie — `preload` pominięty świadomie, żeby nie ryzykować
        pobrania drugiej kopii pliku obok tej, której używa CSS.
        Za brak CLS odpowiadają metryki fallbacku w global.css (SPEC 5). */}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.nazwa} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={canonical} />

    {
      sekwencjaOtwarcia && (
        <script is:inline>
          {/* Ustawiamy tryb ruchu, zanim cokolwiek zostanie namalowane —
              inaczej hero mignąłby gotowy i dopiero potem schował się pod
              sekwencję. `przed` włącza stan początkowy z global.css. */}
          (() => {
            const de = document.documentElement;
            const cicho = matchMedia('(prefers-reduced-motion: reduce)').matches;
            de.dataset.ruch = cicho ? 'off' : 'przed';
            if (cicho) return;
            // Bezpiecznik: gdyby moduł ruchu nie wstał albo fonty nie
            // przyszły, treść i tak musi się pokazać.
            setTimeout(() => {
              if (de.dataset.ruch === 'przed') de.dataset.ruch = 'off';
            }, 2500);
          })();
        </script>
      )
    }
  </head>

  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>

    <Nav linki={navLinki} cta={navCta} />

    <main id="tresc">
      <slot />
    </main>

    <Footer />

    {pasekMobile && <MobileBar />}

    <script>
      import { initMotion } from '../scripts/motion';
      import { initNav } from '../scripts/nav';
      import { initSegmentChips } from '../scripts/segment';
      import { initAccordions } from '../scripts/accordion';
      import { initCityCheck } from '../scripts/city';
      import { initAudit } from '../scripts/audit';
      import { initForms, initPasekPrzyFormularzach } from '../scripts/forms';
      import { initPricing } from '../scripts/pricing';

      // Menu, chipy, akordeony i sprawdzarka muszą działać niezależnie od
      // preferencji ruchu, więc nie czekają na GSAP (SPEC 10.1).
      // Etap 8 przełoży to na `astro:page-load`.
      function start() {
        initNav();
        initSegmentChips();
        initAccordions();
        initCityCheck();
        initAudit();
        initForms();
        initPasekPrzyFormularzach();
        initPricing();
        void initMotion();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    </script>
  </body>
</html>

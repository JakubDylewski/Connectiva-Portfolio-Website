---
/**
 * Case study projektu pokazowego (SPEC 9.1, Etap 7).
 *
 * Trzy strony z jednego źródła danych (`src/data/projekty.ts`) — treść nie
 * jest tu duplikowana, tylko czytana. Układ wprost z 9.1: nagłówek → dwa
 * zrzuty w przesunięciu → Wyzwanie → Co zbudowaliśmy → Liczby → Dla kogo
 * to wzór → ujawnienie → CTA i linki krzyżowe.
 *
 * Warstwa przebarwienia projektu jest tu stała (`TintLayers stale` —
 * SPEC 10.6), a zrzut mobile dostaje na desktopie lekki paralaks
 * (`data-paralaks`, obsługa w `motion.ts`).
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Lacznik from '../../components/Lacznik.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import TintLayers from '../../components/TintLayers.astro';
import { ETYKIETA_POKAZOWA, projekty, type Projekt } from '../../data/projekty';

export function getStaticPaths() {
  return projekty.map((p) => ({ params: { slug: p.slug }, props: { projekt: p } }));
}

interface Props {
  projekt: Projekt;
}

const { projekt } = Astro.props;
const pozostale = projekty.filter((p) => p.slug !== projekt.slug);

/* Wyniki Lighthouse tylko z datą pomiaru (SPEC 15) — jak w ProjectPanel. */
const dataPL = projekt.lighthouseDate
  ? new Date(projekt.lighthouseDate).toLocaleDateString('pl-PL', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
---

<Base tytul={projekt.seoTytul} opis={projekt.seoOpis} pasekMobile>
  <TintLayers stale={projekt.slug} />

  <article class="case">
    <div class="kontener">
      <Breadcrumbs
        okruchy={[
          { etykieta: 'Projekty', href: '/#projekty' },
          { etykieta: projekt.nazwa },
        ]}
      />

      {/* 1. Nagłówek (SPEC 9.1) */}
      <header class="case__glowa">
        <p class="case__etykieta">{ETYKIETA_POKAZOWA}</p>
        <h1 class="case__nazwa">{projekt.nazwa}</h1>
        <p class="case__segment">{projekt.segment}</p>

        <Lacznik wariant="section" class="case__lacznik" />

        <div class="case__akcje">
          <Button href={projekt.demo} zewnetrzny>Otwórz demo</Button>
          <p class="case__host">{projekt.demoEtykieta}</p>
        </div>
      </header>

      {/* 2. Dwa zrzuty w przesunięciu: mobile niżej i w prawo (SPEC 6.2, 9.1) */}
      <div class="case__zrzuty">
        <img
          class="case__desktop"
          src={projekt.zrzutDesktop.src}
          width={projekt.zrzutDesktop.width}
          height={projekt.zrzutDesktop.height}
          alt={projekt.altDesktop}
          decoding="async"
          fetchpriority="high"
        />
        <div class="case__telefon" data-paralaks>
          <PhoneFrame>
            <img
              class="case__mobile"
              src={projekt.zrzutMobile.src}
              width={projekt.zrzutMobile.width / 2}
              height={projekt.zrzutMobile.height / 2}
              alt={projekt.altMobile}
              decoding="async"
              loading="lazy"
              fetchpriority="low"
            />
          </PhoneFrame>
        </div>
      </div>

      {/* 3. Wyzwanie */}
      <section class="case__sekcja">
        <h2 class="case__naglowek">Wyzwanie</h2>
        <p class="case__wyzwanie">{projekt.wyzwanie}</p>
      </section>

      {/* 4. Co zbudowaliśmy */}
      <section class="case__sekcja">
        <h2 class="case__naglowek">Co zbudowaliśmy</h2>
        <ul class="case__lista">
          {
            projekt.zbudowalismy.map((punkt) => (
              <li class="case__punkt">
                <Lacznik wariant="inline" class="case__marker" />
                <span>{punkt}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {/* 5. Liczby — wyniki Lighthouse tylko z datą pomiaru (SPEC 15) */}
      <section class="case__sekcja">
        <h2 class="case__naglowek">Liczby</h2>
        <ul class="case__liczby">
          {projekt.liczby.map((l) => <li>{l}</li>)}
          {dataPL && projekt.lighthouse.map((l) => <li>{l}</li>)}
        </ul>
        {dataPL && <p class="case__pomiar">Pomiar z {dataPL}.</p>}
      </section>

      {/* 6. Dla kogo to wzór */}
      <section class="case__sekcja">
        <h2 class="case__naglowek">Dla kogo to wzór</h2>
        <p class="case__dlakogo">{projekt.dlaKogo}</p>
        <p class="case__miasto">
          <a class="link" href="/#miasto">Sprawdź, czy Twoje miasto jest wolne</a>
        </p>
      </section>

      {/* 7. Ujawnienie (SPEC 15) */}
      <p class="case__ujawnienie">
        {projekt.nazwa} to marka fikcyjna, stworzona wyłącznie jako projekt
        pokazowy. Zdjęcia w&nbsp;demie są wygenerowane — u&nbsp;realnych
        klientek pracujemy na sesji zdjęciowej.
      </p>

      {/* 8. CTA + linki krzyżowe (przesunięte — SPEC 6.2) */}
      <section class="case__sekcja case__cta">
        <h2 class="case__naglowek">Teraz sprawdź swoją stronę</h2>
        <p class="case__cta-lead">
          Sześć pytań w&nbsp;60 sekund, a&nbsp;jeśli zechcesz — audyt wideo
          z&nbsp;konkretami w&nbsp;48 godzin. Bez zobowiązań.
        </p>
        <Button href="/audyt/" class="case__cta-przycisk">Bezpłatny audyt</Button>
      </section>

      <section class="case__sekcja">
        <h2 class="case__naglowek">Pozostałe projekty</h2>
        <div class="case__inne">
          {
            pozostale.map((p, i) => (
              <a
                class:list={['case__inny', i === 1 && 'case__inny--przesuniety']}
                href={p.caseStudy}
              >
                <span class="case__inny-etykieta">{ETYKIETA_POKAZOWA}</span>
                <span class="case__inny-nazwa">{p.nazwa}</span>
                <span class="case__inny-segment">{p.segment}</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </article>
</Base>

<style>
  .case {
    padding-block: calc(var(--spacing-margines) + 4rem) var(--spacing-sekcja);
  }

  /* --- nagłówek ----------------------------------------------------------- */

  .case__glowa {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .case__etykieta {
    font-size: var(--text-small);
    color: var(--color-text-3);
    max-width: none;
  }

  /* Nazwa marki to jeden obiekt — bez ręcznego łamania na dwie linie,
     tak samo jak w panelu sekcji 01 (ProjectPanel). */
  .case__nazwa {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--text-display-1);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .case__segment {
    margin-top: 0.75rem;
    font-size: var(--text-lead);
    color: var(--color-text-2);
  }

  .case__lacznik {
    margin-top: 2rem;
  }

  .case__akcje {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .case__host {
    font-size: var(--text-small);
    color: var(--color-text-3);
    max-width: none;
  }

  /* --- dwa zrzuty w przesunięciu ------------------------------------------ */

  .case__zrzuty {
    position: relative;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .case__desktop {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }

  /* Mobile-first: telefon pod zrzutem desktopowym, niżej i w prawo,
     z lekkim nachodzeniem (zasada przesunięcia, SPEC 6.2). */
  .case__telefon {
    position: relative;
    width: min(62vw, 20rem);
    margin-left: auto;
    margin-top: clamp(-4.5rem, -10vw, -2rem);
  }

  .case__mobile {
    width: 100%;
    height: auto;
    /* Zrzut jest wyższy od ekranu — nadmiar przycina ramka (SPEC 7.6). */
  }

  @media (min-width: 1024px) {
    /* Miejsce na telefon wystający pod zrzutem desktopowym. */
    .case__zrzuty {
      padding-bottom: 8rem;
    }

    .case__desktop {
      width: 86%;
    }

    /* Pozycja absolutna zamiast transformu: transformem steruje paralaks
       z motion.ts i nie może się z niczym bić (SPEC 10.2). */
    .case__telefon {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 17rem;
      margin: 0;
    }
  }

  /* --- sekcje treści ------------------------------------------------------- */

  .case__sekcja {
    margin-top: clamp(4rem, 2.8rem + 4vw, 6rem);
  }

  .case__naglowek {
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.01em;
  }

  .case__wyzwanie,
  .case__dlakogo {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-text-2);
  }

  .case__lista {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }

  .case__punkt {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    max-width: 44rem;
  }

  .case__punkt + .case__punkt {
    border-top: 1px solid var(--color-line);
  }

  .case__marker {
    /* Marker Łącznika siedzi na linii pierwszego wiersza tekstu. */
    transform: translateY(-0.1em);
  }

  .case__liczby {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    max-width: 44rem;
    font-size: var(--text-lead);
    font-variant-numeric: tabular-nums;
  }

  .case__liczby li {
    padding-block: 1rem;
  }

  .case__liczby li + li {
    border-top: 1px solid var(--color-line);
  }

  .case__pomiar {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--color-text-3);
  }

  .case__miasto {
    margin-top: 1rem;
  }

  /* --- ujawnienie ---------------------------------------------------------- */

  .case__ujawnienie {
    margin-top: clamp(4rem, 2.8rem + 4vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
    color: var(--color-text-2);
  }

  /* --- CTA i linki krzyżowe ------------------------------------------------ */

  .case__cta-lead {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-text-2);
  }

  .case__cta :global(.case__cta-przycisk) {
    margin-top: 2rem;
  }

  .case__inne {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case__inny {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    text-decoration: none;
    transition:
      border-color 150ms var(--ease-wejscie),
      background-color 150ms var(--ease-wejscie);
  }

  .case__inny:hover {
    border-color: var(--color-line-2);
    background-color: var(--color-ink-1);
  }

  .case__inny-etykieta {
    font-size: var(--text-small);
    color: var(--color-text-3);
  }

  .case__inny-nazwa {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .case__inny-segment {
    font-size: var(--text-small);
    color: var(--color-text-2);
  }

  @media (min-width: 1024px) {
    .case__inne {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: start;
    }

    /* Para przesunięta (SPEC 6.2) — margines, nie transform, żeby nie
       wchodzić w drogę żadnej animacji. */
    .case__inny--przesuniety {
      margin-top: 2.5rem;
    }
  }
</style>

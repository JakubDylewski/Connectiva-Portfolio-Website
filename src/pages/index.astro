---
/**
 * Strona główna (SPEC 17.2 — rewizja v2).
 *
 * Kolejność sekcji i licznik „NN / 06" wprost z 17.2: hero → 01 Projekty
 * → 02 Co dostajesz → 03 Sprawdź swoją stronę (audyt) → 04 Jak pracujemy
 * → 05 Ile to kosztuje → 06 Pytania → Kontakt (bez numeru).
 *
 * Sekcja 05 to kreator wyceny (17.4) — do kotwicy `#kreator` prowadzą
 * linki z podstron projektów.
 *
 * DO DECYZJI JAKUBA (SPEC 6.2 — nagłówki mają dokładnie dwie linie).
 * Zmierzone na 360 px przy display-2 = 34 px — dwa nagłówki łamią się
 * na więcej niż dwie linijki:
 *   01 „Trzy segmenty rynku. / Trzy projekty pokazowe."    → 4 linie
 *   02 „Jeden produkt. / Wszystko, co zapełnia kalendarz." → 3 linie
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import SectionHead from '../components/SectionHead.astro';
import Accordion from '../components/Accordion.astro';
import Audit from '../components/Audit.astro';
import Process from '../components/Process.astro';
import Kreator from '../components/Kreator.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { zakres } from '../data/zakres';
---

<Base
  tytul="Strony dla salonów beauty i klinik medycyny estetycznej — Connectiva"
  pasekMobile
  sekwencjaOtwarcia
>
  <Hero />

  <Projects />

  {/* 02 Co dostajesz (SPEC 8.2) */}
  <section id="zakres" class="sekcja">
    <div class="kontener">
      <SectionHead
        index="02"
        linia1="Jeden produkt."
        linia2="Wszystko, co zapełnia kalendarz."
        lead="Nie sprzedajemy pakietów. Jest jedna strona, zrobiona do końca — od projektu po pierwsze rezerwacje."
        lacznik
      />
      <Accordion pozycje={zakres} class="sekcja__akordeon" />
    </div>
  </section>

  {/* 03 Sprawdź swoją stronę (SPEC 8.4, kolejność 17.2) — główna konwersja */}
  <section id="audyt" class="sekcja">
    <div class="kontener">
      <SectionHead
        index="03"
        linia1="Sprawdź swoją stronę"
        linia2={'w 60 sekund.'}
        lead="Sześć pytań. Bez logowania, bez maila. Na końcu zdecydujesz, czy chcesz pełny audyt wideo."
        lacznik
      />
      <Audit />
    </div>
  </section>

  {/* 04 Jak pracujemy (SPEC 8.5, kolejność 17.2; treść bez terminów w Etapie 11) — pin 2 z 2 na desktopie */}
  <Process />

  {/* 05 Ile to kosztuje (17.2, 17.4) — kreator wyceny */}
  <section id="kreator" class="sekcja">
    <div class="kontener">
      <SectionHead
        index="05"
        linia1="Każdy projekt wyceniamy osobno."
        linia2={'Sprawdź, w\u00A0jakim jesteś przedziale.'}
        lead={'Sześć pytań o\u00A0to, czego potrzebujesz. Na końcu zobaczysz orientacyjne widełki i\u00A0dokładnie to, co się na nie składa. Bez logowania, bez zobowiązań.'}
        lacznik
      />
      <Kreator />
    </div>
  </section>

  {/* 06 Pytania (SPEC 8.7, zmiany treści w Etapie 14) */}
  <section id="pytania" class="sekcja">
    <div class="kontener">
      <SectionHead
        index="06"
        linia1="Osiem pytań."
        linia2="Osiem odpowiedzi."
        lead={'Wszystko, o co pytają najczęściej: termin, rezerwacja, prawa do strony, faktury i zakaz reklamy w klinikach.'}
        lacznik
      />
      <Faq />
    </div>
  </section>

  {/* Kontakt (SPEC 8.8) — bez numeru */}
  <section id="kontakt" class="sekcja">
    <div class="kontener">
      <SectionHead
        linia1="Zacznijmy"
        linia2="od Twojej strony."
        lead={'Napisz, a odezwiemy się w ciągu 24 godzin w dni robocze.'}
        lacznik
      />
      <Contact />
    </div>
  </section>
</Base>

<style>
  .sekcja {
    padding-block: var(--spacing-sekcja);
    scroll-margin-top: 5rem;
  }



  .sekcja__akordeon {
    margin-top: 3rem;
  }
</style>

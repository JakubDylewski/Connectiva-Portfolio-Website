---
/**
 * /cennik/ (SPEC 8.6, 9).
 *
 * Ten sam konfigurator co sekcja 06 na stronie głównej, plus pytania o cenę.
 * Reszta FAQ dochodzi w Etapie 6 — wtedy te dwa pytania przenosimy do
 * `src/data/faq.ts` i stąd je importujemy, żeby nie żyły w dwóch miejscach.
 *
 * `noindex` do Etapu 6, tak jak pozostałe strony.
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Pricing from '../components/Pricing.astro';
import Accordion from '../components/Accordion.astro';
import type { PozycjaAkordeonu } from '../components/Accordion.astro';

/** Pytania o płatność i fakturę (SPEC 8.7, pozycja 4). */
const pytaniaOCene: PozycjaAkordeonu[] = [
  {
    tytul: 'Dostanę fakturę?',
    tresc: 'Tak, na każdą z trzech części płatności.',
  },
];
---

<Base
  tytul="Cennik stron dla salonów beauty i klinik — Connectiva"
  opis="Jedna cena widełkowa, znana przed startem: 8 000–10 000 zł. Po rozmowie dostajesz kwotę końcową i to ona jest w umowie."
  noindex
  pasekMobile
>
  <section class="strona-cennik">
    <div class="kontener">
      <SectionHead
        poziom="h1"
        linia1="8 000–10 000 zł."
        linia2={'Tyle, nie „od”.'}
        lead="Jedna cena widełkowa, znana przed startem. Po rozmowie dostajesz kwotę końcową i to ona jest w umowie."
        lacznik
      />

      <Pricing />

      <div class="strona-cennik__pytania">
        <h2 class="strona-cennik__naglowek">Pytania o cenę</h2>
        <Accordion pozycje={pytaniaOCene} />
      </div>
    </div>
  </section>
</Base>

<style>
  .strona-cennik {
    padding-block: var(--spacing-sekcja);
  }

  .strona-cennik__pytania {
    margin-top: var(--spacing-sekcja);
  }

  .strona-cennik__naglowek {
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.01em;
    margin-bottom: 2.5rem;
  }
</style>

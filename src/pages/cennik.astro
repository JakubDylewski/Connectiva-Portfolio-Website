---
/**
 * /cennik/ (SPEC 17.4).
 *
 * Ten sam kreator wyceny co sekcja 05 na stronie głównej, a pod nim blok
 * „Nie ma w cenie" i zasada płatności etapami — oba z `cennik.json`,
 * żeby treść nie żyła w dwóch miejscach.
 *
 * Tytuły bloków to `p`, nie nagłówki — stoją po h1 i h2/h3 łamałyby
 * kolejność nagłówków (wzór ze stopki, SPEC 11.3).
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Kreator from '../components/Kreator.astro';
import cennik from '../data/cennik.json';
---

<Base
  tytul="Cennik stron dla salonów beauty i klinik — Connectiva"
  opis="Sześć pytań o to, czego potrzebujesz. Na końcu zobaczysz orientacyjne widełki i dokładnie to, co się na nie składa. Bez logowania, bez zobowiązań."
  pasekMobile
>
  <section class="strona-cennik">
    <div class="kontener">
      <SectionHead
        poziom="h1"
        linia1="Każdy projekt wyceniamy osobno."
        linia2={'Sprawdź, w\u00A0jakim jesteś przedziale.'}
        lead={'Sześć pytań o\u00A0to, czego potrzebujesz. Na końcu zobaczysz orientacyjne widełki i\u00A0dokładnie to, co się na nie składa. Bez logowania, bez zobowiązań.'}
        lacznik
      />

      <Kreator />

      <div class="strona-cennik__dol">
        <div class="strona-cennik__blok">
          <p class="strona-cennik__tytul">Nie ma w&nbsp;cenie</p>
          <ul class="strona-cennik__lista">
            {cennik.nieMaWCenie.map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="strona-cennik__blok">
          <p class="strona-cennik__tytul">Płatność</p>
          <p class="strona-cennik__tekst">{cennik.platnosc}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .strona-cennik {
    padding-block: var(--spacing-sekcja);
  }

  .strona-cennik__dol {
    display: grid;
    gap: 2.5rem;
    margin-top: var(--spacing-sekcja);
    max-width: 44rem;
  }

  .strona-cennik__tytul {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-2);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .strona-cennik__lista {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-text-3);
  }

  .strona-cennik__lista li {
    display: flex;
    gap: 0.75rem;
  }

  .strona-cennik__lista li::before {
    content: '';
    flex: none;
    width: 12px;
    height: 1px;
    margin-top: 0.8em;
    background-color: var(--color-line-2);
  }

  .strona-cennik__tekst {
    margin-top: 1.25rem;
    color: var(--color-text-2);
  }

  @media (min-width: 768px) {
    .strona-cennik__dol {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>

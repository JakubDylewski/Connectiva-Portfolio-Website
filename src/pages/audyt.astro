---
/**
 * /audyt/ — ten sam komponent co sekcja 04 na stronie głównej (SPEC 8.4, 9).
 *
 * Osobna strona istnieje po to, żeby dało się wysłać sam audyt w wiadomości
 * na Instagramie, bez przewijania całej strony głównej.
 *
 * Od Etapu 6 strona jest indeksowalna — warstwa SEO jest na miejscu.
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Audit from '../components/Audit.astro';
---

<Base
  tytul="Bezpłatny audyt strony w 60 sekund — Connectiva"
  opis="Sześć pytań o Twoją stronę. Bez logowania, bez maila. Na końcu zdecydujesz, czy chcesz pełny audyt wideo."
  pasekMobile
>
  <section class="strona-audyt">
    <div class="kontener">
      <SectionHead
        poziom="h1"
        linia1="Sprawdź swoją stronę"
        linia2={'w 60 sekund.'}
        lead="Sześć pytań. Bez logowania, bez maila. Na końcu zdecydujesz, czy chcesz pełny audyt wideo."
        lacznik
      />
      <Audit />
    </div>
  </section>
</Base>

<style>
  .strona-audyt {
    padding-block: var(--spacing-sekcja);
  }
</style>

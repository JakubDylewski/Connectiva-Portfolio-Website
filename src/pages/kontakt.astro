---
/**
 * /kontakt/ (SPEC 8.8, 9).
 *
 * Ta sama sekcja kontaktu co na stronie głównej (SPEC 8.8, 17.2).
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Contact from '../components/Contact.astro';
---

<Base
  tytul="Kontakt — Connectiva"
  opis="Napisz, jeśli chcesz stronę, która zapełnia kalendarz. Odpowiedź w ciągu 24 godzin w dni robocze."
  pasekMobile
>
  <section class="strona-kontakt">
    <div class="kontener">
      <SectionHead
        poziom="h1"
        linia1="Zacznijmy"
        linia2="od Twojej strony."
        lead={'Napisz, a odezwiemy się w ciągu 24 godzin w dni robocze.'}
        lacznik
      />

      <Contact />
    </div>
  </section>
</Base>

<style>
  .strona-kontakt {
    padding-block: var(--spacing-sekcja);
  }
</style>
